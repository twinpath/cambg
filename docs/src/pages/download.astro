---
import Layout from "@/layouts/main.astro"
import { DownloadContent } from "@/components/download/DownloadContent"
import { InstallGuide } from "@/components/download/InstallGuide"
import { RELEASE_ARCHIVE } from "@/data/releases"
import { DOWNLOAD_PAGE_METADATA } from "@/data/download"

const releases = RELEASE_ARCHIVE
---

<Layout
  title={DOWNLOAD_PAGE_METADATA.title}
  description={DOWNLOAD_PAGE_METADATA.description}
>
  <DownloadContent fallbackReleases={releases} client:load />
  <InstallGuide client:load />
</Layout>

