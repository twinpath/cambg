---
import Layout from "@/layouts/main.astro"
import { DownloadHero } from "@/components/download/DownloadHero"
import { ReleaseArchive } from "@/components/download/ReleaseArchive"
import { InstallGuide } from "@/components/download/InstallGuide"
import { fetchGitHubReleases } from "@/lib/github"
import { DOWNLOAD_PAGE_METADATA } from "@/data/download"

const releases = await fetchGitHubReleases()
const latest = releases[0]
---

<Layout
  title={DOWNLOAD_PAGE_METADATA.title}
  description={DOWNLOAD_PAGE_METADATA.description}
>
  <DownloadHero latest={latest} client:load />
  <ReleaseArchive releases={releases} client:load />
  <InstallGuide client:load />
</Layout>

