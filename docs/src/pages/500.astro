---
import Layout from "@/layouts/main.astro"
import { ErrorView } from "@/components/error/ErrorView"
---

<Layout title="500 Internal Server Error" description="An internal server error occurred. Please try again later.">
  <ErrorView
    statusCode={500}
    title="Internal Server Error"
    description="An internal error occurred on our server system. We are working to resolve the issue as soon as possible."
    client:load
  />
</Layout>
