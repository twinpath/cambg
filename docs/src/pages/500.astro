---
import Layout from "@/layouts/main.astro"
import { ErrorView } from "@/components/error/ErrorView"
import { ERROR_VIEW_CONTENT } from "@/data/error"
---

<Layout title={ERROR_VIEW_CONTENT[500].pageTitle} description={ERROR_VIEW_CONTENT[500].pageDescription}>
  <ErrorView
    statusCode={500}
    title={ERROR_VIEW_CONTENT[500].title}
    description={ERROR_VIEW_CONTENT[500].description}
    client:load
  />
</Layout>
