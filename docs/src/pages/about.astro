---
import Layout from "@/layouts/main.astro"
import { AboutHero } from "@/components/about/AboutHero"
import { ArchitectureSection } from "@/components/about/ArchitectureSection"
import { TechStackSection } from "@/components/about/TechStackSection"
import { FaqSection } from "@/components/about/FaqSection"
import { ProjectInfoSection } from "@/components/about/ProjectInfoSection"
import { ABOUT_PAGE_METADATA } from "@/data/about"
---

<Layout
  title={ABOUT_PAGE_METADATA.title}
  description={ABOUT_PAGE_METADATA.description}
>
  <AboutHero client:load />
  <ArchitectureSection client:load />
  <TechStackSection client:load />
  <FaqSection client:load />
  <ProjectInfoSection client:load />
</Layout>

