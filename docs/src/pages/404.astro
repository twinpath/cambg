---
import Layout from "@/layouts/main.astro"
import { ErrorView } from "@/components/ErrorView"
---

<Layout title="404 Page Not Found" description="Sorry, the page you are looking for could not be found. Please return to home.">
  <ErrorView
    statusCode={404}
    title="Page Not Found"
    description="Sorry, the page you are looking for does not exist or has been moved to another address."
    client:load
  />
</Layout>
