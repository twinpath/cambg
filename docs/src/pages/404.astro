---
import Layout from "@/layouts/main.astro"
import { ErrorView } from "@/components/error/ErrorView"
import { ERROR_VIEW_CONTENT } from "@/data/error"
---

<Layout title={ERROR_VIEW_CONTENT[404].pageTitle} description={ERROR_VIEW_CONTENT[404].pageDescription}>
  <ErrorView
    statusCode={404}
    title={ERROR_VIEW_CONTENT[404].title}
    description={ERROR_VIEW_CONTENT[404].description}
    client:load
  />
</Layout>
