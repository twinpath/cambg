# =================================================================
# GitHub Actions Secrets & Local App Environment Config Template
# =================================================================
# NOTE: This .env / .env.example template is ONLY used for local development.
# All environment variables (such as KEYSTORE_BASE64, STORE_PASSWORD, KEY_PASSWORD, GEMINI_API_KEY)
# are already securely stored in GitHub Actions Secrets for automated GitHub builds.


# --- Release Signing Configuration ---
# Base64-encoded string of the release keystore file (my-upload-key.jks)
# Generate via: [Convert]::ToBase64String([IO.File]::ReadAllBytes('my-upload-key.jks'))
KEYSTORE_BASE64=your_keystore_base64_encoded_string

# Password for the keystore
STORE_PASSWORD=your_store_password

# Password for the key (usually same as store password for PKCS12 format)
KEY_PASSWORD=your_key_password


# --- Gemini API Configuration ---
# Required for Gemini AI API calls and automated release notes generation
GEMINI_API_KEY=your_gemini_api_key
